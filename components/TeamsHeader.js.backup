import React, { useState, useEffect } from 'react';
import { View, Text, TouchableOpacity, StyleSheet, Platform, ScrollView, Modal, Dimensions, Alert, Image, ImageBackground } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { SPACING, FONTS } from '../styles/theme';
import { useTheme } from '../contexts/ThemeContext';
import { useRouter } from 'expo-router';
import PentaPointsService from '../services/pentaPointsService';

export const TeamsHeader = ({ 
  teams = [], 
  currentTeamIndex = 0, 
  scores = {}, 
  onTeamChange, 
  onScoreChange,
  onEndRound, 
  isDoublePoints, 
  onDoublePointsChange, 
  usedDoublePoints = {},
  isPentaPoints,
  onPentaPointsChange,
  usedPentaPoints = {},
  pentaPointsEnabled = true
}) => {
  const { theme } = useTheme();
  const router = useRouter();
  const [showTeamSelector, setShowTeamSelector] = useState(false);
  const screenWidth = Dimensions.get('window').width;
  const isSmallScreen = screenWidth < 768;
  
  const validTeams = Array.isArray(teams) ? teams : [];
  const validScores = typeof scores === 'object' ? scores : {};
  const validDoublePoints = typeof usedDoublePoints === 'object' ? usedDoublePoints : {};
  const validPentaPoints = typeof usedPentaPoints === 'object' ? usedPentaPoints : {};

  // التحقق مما إذا كان الفريق هو صاحب أقل نقاط
  const isLowestScoringTeam = (teamName) => {
    return PentaPointsService.isLowestScoringTeam(teamName, validTeams, validScores);
  };

  const primaryColorWithOpacity = `${theme.colors.primary}80`;
  const primaryColorWithLessOpacity = `${theme.colors.primary}40`;

  const getScoreColor = (score) => {
    if (score > 0) return theme.colors.success;
    if (score < 0) return theme.colors.error;
    return theme.colors.text.secondary;
  };

  if (!theme) {
    return null;
  }

  if (!validTeams.length) {
    console.log('No valid teams found');
    return null;
  }

  const handleTeamSelect = (index) => {
    if (onTeamChange) {
      onTeamChange(index);
      setShowTeamSelector(false);
    }
  };

  const handleEndRound = () => {
    onEndRound();
  };
  
  const styles = StyleSheet.create({
    container: {
      backgroundColor: 'rgba(255, 255, 255, 0.3)', 
      borderBottomWidth: 0, 
      borderBottomColor: theme.colors.border,
      paddingVertical: 2,
      minHeight: 32,
      flexDirection: 'column',
      position: 'relative',
      borderRadius: 66,
      margin: 4,
      marginTop: 12, 
      borderWidth: 2, 
      borderColor: primaryColorWithOpacity, 
      overflow: 'hidden',
      ...Platform.select({
        web: {
          boxShadow: `0 4px 8px rgba(0, 0, 0, 0.3)`, 
        },
        default: {
          elevation: 5, 
          shadowColor: '#000000', 
          shadowOffset: { width: 0, height: 4 }, 
          shadowOpacity: 0.3, 
          shadowRadius: 6, 
        }
      })
    },
    innerBorder: {
      position: 'absolute',
      top: 2,
      left: 2,
      right: 2,
      bottom: 2,
      borderWidth: 2,
      borderColor: primaryColorWithLessOpacity, 
      borderRadius: 62, 
      pointerEvents: 'none', 
    },
    headerContent: {
      flexDirection: 'row',
      alignItems: 'center',
      justifyContent: 'center',
      width: '100%',
      overflow: 'hidden',
      borderRadius: 62,
      position: 'relative',
    },
    headerFireBackground: {
      position: 'absolute',
      width: '100%',
      height: '100%',
      opacity: 0.6,
      zIndex: -1,
      borderRadius: 62,
    },
    endRoundButton: {
      position: 'absolute',
      left: SPACING.sm,
      backgroundColor: '#FF0000',
      paddingHorizontal: SPACING.sm,
      paddingVertical: 4,
      borderRadius: 66,
      flexDirection: 'row',
      alignItems: 'center',
      justifyContent: 'center',
      minWidth: 50,
      height: 40,
      width: 50,
      top: '50%',
      transform: [{ translateY: -20 }],
      zIndex: 1,
      borderWidth: 2,
      borderColor: '#990000',
      ...Platform.select({
        web: {
          boxShadow: `0 4px 8px rgba(0,0,0,0.3)`,
        },
        default: {
          elevation: 5,
        }
      })
    },
    endRoundButtonText: {
      color: '#FFFFFF',
      fontSize: 10,
      fontWeight: FONTS.weights.bold,
      textAlign: 'center',
    },
    teamsScroll: {
      flexGrow: 1,
      marginLeft: 100,
      marginRight: SPACING.md,
    },
    teamsContainer: {
      flexDirection: 'row',
      justifyContent: 'center',
      alignItems: 'center',
      gap: 6,
      paddingVertical: 1,
    },
    teamCard: {
      minWidth: 100,
      maxWidth: 150,
      height: 70,
      borderRadius: 8,
      borderWidth: 2,
      marginHorizontal: 4,
      padding: 0,
      position: 'relative',
      overflow: 'hidden',
    },
    fireBackground: {
      position: 'absolute',
      width: '100%',
      height: '100%',
      opacity: 0.8,
    },
    activeTeamCard: {
      transform: [{ scale: 1.02 }],
      borderColor: theme.colors.primary,
      borderWidth: 2,
      ...Platform.select({
        web: {
          boxShadow: `0 4px 12px ${theme.colors.overlay}`,
        }
      })
    },
    teamMainContent: {
      flex: 1,
      paddingHorizontal: 6,
      paddingTop: 6,
      paddingRight: 32,
      paddingBottom: 24, 
    },
    teamName: {
      fontSize: isSmallScreen ? 10 : 12,
      fontWeight: '700',
      color: theme.colors.text.primary,
      textAlign: 'center',
    },
    scoreRow: {
      flexDirection: 'row',
      alignItems: 'center',
      justifyContent: 'center',
      gap: 4,
      backgroundColor: theme.colors.background.card,
      padding: 1,
      borderRadius: 6,
      width: '100%',
    },
    scoreButton: {
      width: 16,
      height: 16,
      borderRadius: 8,
      alignItems: 'center',
      justifyContent: 'center',
      borderWidth: 1,
    },
    scoreButtonMinus: {
      backgroundColor: `${theme.colors.error}15`,
      borderColor: theme.colors.error,
    },
    scoreButtonPlus: {
      backgroundColor: `${theme.colors.success}15`,
      borderColor: theme.colors.success,
    },
    scoreButtonText: {
      fontSize: 12,
      fontWeight: 'bold',
      textAlign: 'center',
      lineHeight: 16,
    },
    scoreText: {
      fontSize: 12,
      fontWeight: 'bold',
      minWidth: 28,
      textAlign: 'center',
      color: theme.colors.text.primary,
    },
    doubleButton: {
      width: 24,
      height: 24,
      justifyContent: 'center',
      alignItems: 'center',
      borderRadius: 6,
      backgroundColor: '#E3F2FD', 
      borderWidth: 1,
      borderColor: theme.colors.success, 
      position: 'absolute',
      right: 6,
      top: 6,
    },
    doubleButtonText: {
      fontSize: 10,
      fontWeight: 'bold',
      color: theme.colors.success, 
    },
    doubleButtonActive: {
      backgroundColor: `${theme.colors.success}40`, 
    },
    doubleButtonDisabled: {
      backgroundColor: '#E0E0E0', 
      opacity: 0.8,
      borderColor: '#9E9E9E',
    },
    doubleButtonTextDisabled: {
      color: '#9E9E9E', 
    },
    pentaButton: {
      height: 22,
      justifyContent: 'center',
      alignItems: 'center',
      borderTopLeftRadius: 0,
      borderTopRightRadius: 0,
      borderBottomLeftRadius: 6,
      borderBottomRightRadius: 6,
      backgroundColor: '#F44336', 
      borderWidth: 0,
      borderTopWidth: 1,
      borderColor: '#D32F2F',
      marginTop: 0,
      width: '100%',
      position: 'absolute',
      bottom: 0,
      left: 0,
      right: 0,
    },
    pentaButtonActive: {
      backgroundColor: '#B71C1C', 
    },
    pentaButtonDisabled: {
      backgroundColor: '#E0E0E0', 
      opacity: 0.8,
      borderColor: '#9E9E9E',
    },
    pentaButtonTextDisabled: {
      color: '#9E9E9E', 
    },
    pentaButtonNotAllowed: {
      backgroundColor: '#E0E0E0', 
      opacity: 0.6,
      borderColor: '#9E9E9E',
    },
    pentaButtonTextNotAllowed: {
      color: '#9E9E9E', 
    },
    lowestScoreBadge: {
      position: 'absolute',
      top: -8,
      right: 8,
      backgroundColor: '#C70000', 
      borderRadius: 8,
      width: 14,
      height: 14,
      justifyContent: 'center',
      alignItems: 'center',
      zIndex: 10,
    },
    lowestScoreBadgeText: {
      color: 'white',
      fontSize: 8,
      fontWeight: 'bold',
    },
    multiplierButtonsContainer: {
      position: 'absolute',
      right: 4,
      top: '50%',
      transform: [{ translateY: -26 }], 
      justifyContent: 'center',
      alignItems: 'center',
      width: 26,
    },
  });

  const handleScoreChange = (team, change) => {
    if (onScoreChange) {
      onScoreChange(team, change);
    }
  };

  return (
    <View style={[
      styles.container,
      {
        backgroundColor: 'rgba(255, 255, 255, 0.3)', 
        borderColor: primaryColorWithOpacity, 
      }
    ]}>
      <View style={styles.innerBorder} />
      <View style={styles.headerContent}>
        {isPentaPoints && pentaPointsEnabled && (
          <ImageBackground
            source={require('../assets/images/fire.gif')}
            style={styles.headerFireBackground}
            resizeMode="cover"
          />
        )}
        <TouchableOpacity
          style={styles.endRoundButton}
          onPress={handleEndRound}
        >
          <Text style={styles.endRoundButtonText}>إنهاء</Text>
        </TouchableOpacity>

        <ScrollView 
          horizontal
          showsHorizontalScrollIndicator={false}
          style={styles.teamsScroll}
          contentContainerStyle={styles.teamsContainer}
        >
          {validTeams.map((team, index) => (
            <TouchableOpacity 
              key={team}
              style={[
                styles.teamCard,
                { 
                  borderColor: currentTeamIndex === index ? 
                    theme.colors.primary : 
                    theme.colors.border,
                  backgroundColor: `${theme.colors.background.surface}F0`,
                },
                currentTeamIndex === index && styles.activeTeamCard,
              ]}
              onPress={() => onTeamChange?.(index)}
              disabled={false}
            >
              {/* خلفية النار تظهر فقط عندما يكون النظام مفعلاً */}
              {isPentaPoints && pentaPointsEnabled && (
                <ImageBackground
                  source={require('../assets/images/fire.gif')}
                  style={styles.fireBackground}
                  resizeMode="cover"
                />
              )}
              
              <View style={styles.teamMainContent}>
                <Text style={[
                  styles.teamName,
                  { 
                    color: isPentaPoints ? 
                      'white' : 
                      (currentTeamIndex === index ? 
                        theme.colors.primary : 
                        theme.colors.text.primary)
                  }
                ]}>
                  {team}
                </Text>
                
                <View style={styles.scoreRow}>
                  <TouchableOpacity 
                    style={[styles.scoreButton, styles.scoreButtonMinus]}
                    onPress={() => handleScoreChange(team, (validScores[team] || 0) - 50)}
                  >
                    <Text style={[styles.scoreButtonText, { color: theme.colors.error }]}>-</Text>
                  </TouchableOpacity>
                  
                  <Text style={[
                    styles.scoreText,
                    { color: getScoreColor(validScores[team] || 0) }
                  ]}>
                    {validScores[team] || 0}
                  </Text>
                  
                  <TouchableOpacity 
                    style={[styles.scoreButton, styles.scoreButtonPlus]}
                    onPress={() => handleScoreChange(team, (validScores[team] || 0) + 50)}
                  >
                    <Text style={[styles.scoreButtonText, { color: theme.colors.success }]}>+</Text>
                  </TouchableOpacity>
                </View>
              </View>

              {currentTeamIndex === index && (
                <>
                  <TouchableOpacity
                    style={[
                      styles.doubleButton,
                      isDoublePoints && styles.doubleButtonActive,
                      validDoublePoints[team] && styles.doubleButtonDisabled,
                    ]}
                    onPress={() => {
                      if (!validDoublePoints[team]) {
                        onDoublePointsChange(!isDoublePoints);
                      }
                    }}
                    disabled={validDoublePoints[team]}
                  >
                    <Text style={[
                      styles.doubleButtonText,
                      validDoublePoints[team] && styles.doubleButtonTextDisabled,
                    ]}>
                      X2
                    </Text>
                  </TouchableOpacity>

                  {pentaPointsEnabled && (
                    <View style={{ position: 'relative' }}>
                      <TouchableOpacity
                        style={[
                          styles.pentaButton,
                          isPentaPoints && styles.pentaButtonActive,
                          validPentaPoints[team] && styles.pentaButtonDisabled,
                          !isLowestScoringTeam(team) && styles.pentaButtonNotAllowed,
                        ]}
                        onPress={() => {
                          if (!validPentaPoints[team] && isLowestScoringTeam(team)) {
                            onPentaPointsChange(!isPentaPoints);
                          }
                        }}
                        disabled={validPentaPoints[team] || !isLowestScoringTeam(team)}
                      >
                        <Text style={[
                          styles.doubleButtonText,
                          { color: '#FFFFFF' },
                          validPentaPoints[team] && styles.pentaButtonTextDisabled,
                          !isLowestScoringTeam(team) && styles.pentaButtonTextNotAllowed,
                        ]}>
                          علي وعلى أعدائي ×5
                        </Text>
                      </TouchableOpacity>
                    </View>
                  )}
                </>
              )}
            </TouchableOpacity>
          ))}
        </ScrollView>
      </View>
    </View>
  );
}; 